# EX Agent Environment Configuration

# Primary Model & Provider
EX_MODEL=nousresearch/hermes-3-llama-3.1-8b
EX_PROVIDER=openrouter

# Custom Endpoint Override (for any OpenAI-compatible API)
# EX_BASE_URL=https://your-proxy.example.com/v1

# API Keys
OPENROUTER_API_KEY=
NOUS_PORTAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# Local LLM Endpoints (vLLM / Ollama)
# Note: OLLAMA_HOST is auto-normalized (bind address -> 127.0.0.1, /v1 appended)
OLLAMA_HOST=http://localhost:11434
VLLM_HOST=http://localhost:8000/v1

# Gateway & Multi-Channel
EX_GATEWAY_HOST=0.0.0.0
EX_GATEWAY_PORT=8642
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Directory & Storage Overrides (Optional)
# EX_HOME=C:\Users\JM Project\.ex
