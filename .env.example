# Merlin Agent Environment Configuration

# Primary Model & Provider
MERLIN_MODEL=glm-5.3-flash
MERLIN_PROVIDER=ollama

# Custom Endpoint Override (for any OpenAI-compatible API)
# MERLIN_BASE_URL=https://your-proxy.example.com/v1

# API Keys
OPENROUTER_API_KEY=
NOUS_PORTAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# Local LLM Endpoints (vLLM / Ollama)
# Note: OLLAMA_HOST is auto-normalized (bind address -> 127.0.0.1, /v1 appended)
OLLAMA_HOST=http://localhost:11434
VLLM_HOST=http://localhost:8000/v1

# Gateway & Multi-Channel
# Leave MERLIN_GATEWAY_HOST unset to bind loopback only (127.0.0.1, default).
# Set it ONLY if remote clients need access — then also set MERLIN_GATEWAY_API_KEY.
# MERLIN_GATEWAY_HOST=127.0.0.1
MERLIN_GATEWAY_PORT=8642
# Required when the gateway is reachable from non-loopback clients.
# Clients authenticate with "Authorization: Bearer <key>" or ?key=<key>.
# MERLIN_GATEWAY_API_KEY=<generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))">
# Comma-separated extra CORS origins allowed to call the gateway (default: none).
# MERLIN_GATEWAY_CORS_ORIGINS=http://localhost:3000
TELEGRAM_BOT_TOKEN=
# Telegram fail-closed allowlist: comma-separated chat IDs that may use the bot.
# The bot REFUSES to start while this is empty. Send /id to your bot to get the value.
# TELEGRAM_ALLOWED_CHAT_IDS=8621864972
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Directory & Storage Overrides (Optional)
# MERLIN_HOME=C:\Users\JM Project\.ex
